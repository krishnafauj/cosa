# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
JWT_SIGNING_KEY=change-me-too
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---- Database (Neon, POOLED connection string: host contains "-pooler") ----
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_CONN_MAX_AGE=60

# ---- Google login (OAuth client ID from Google Cloud Console) ----
GOOGLE_CLIENT_IDS=
ALLOWED_EMAIL_DOMAINS=iiitr.ac.in,students.iiitr.ac.in
STUDENT_EMAIL_DOMAIN=students.iiitr.ac.in

# ---- Frontend ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- File storage (S3). Leave S3_BUCKET empty to store files locally ----
# While DJANGO_DEBUG=true, files are stored in backend/media/ unless USE_S3=true.
USE_S3=false
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=campus-portal
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Optional ----
REDIS_URL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ESCALATION_AFTER_DAYS=5
REOPEN_WINDOW_DAYS=7
MAX_REOPENS=3
REMARKS_PER_DAY=3

# ---- Student emails ----
# Roll-number emails like cs23b1036@iiitr.ac.in are students.
# Map roll-number branch codes to branches to pre-fill the profile form.
ROLL_BRANCH_CODES=cs:CSE
